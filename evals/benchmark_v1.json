{
  "benchmark": "decision-engine-v1",
  "version": "1.0",
  "purpose": "Evaluate routing-policy behavior in selection-only mode without executing models or incurring API spend.",
  "methodology": {
    "hard_expectations": "Cases where privacy, required capabilities, explicit complexity, or cloud permission define an objective routing constraint.",
    "policy_expectations": "Cases where the expected reasoning/coding tier represents the product policy to be tested, not objective model-quality ground truth.",
    "excluded_claims": "This benchmark does not measure generated-answer quality."
  },
  "cases": [
    {
      "id": "chat-01",
      "category": "simple_chat",
      "prompt": "Explain why the sky appears blue to a 10-year-old.",
      "expected": {
        "reasoning": "low",
        "route": "local"
      },
      "basis": "policy"
    },
    {
      "id": "chat-02",
      "category": "simple_chat",
      "prompt": "Rewrite this sentence to be clearer: The meeting that we had yesterday was one in which several decisions were made.",
      "expected": {
        "reasoning": "low",
        "route": "local"
      },
      "basis": "policy"
    },
    {
      "id": "chat-03",
      "category": "simple_chat",
      "prompt": "Give me five concise title ideas for a weekly project update.",
      "expected": {
        "reasoning": "low",
        "route": "local"
      },
      "basis": "policy"
    },
    {
      "id": "chat-04",
      "category": "simple_chat",
      "prompt": "Summarize the difference between precision and recall in two sentences.",
      "expected": {
        "reasoning": "low",
        "route": "local"
      },
      "basis": "policy"
    },
    {
      "id": "reason-01",
      "category": "reasoning",
      "prompt": "Compare three pricing strategies for a new B2B SaaS product, weigh adoption, revenue, and implementation tradeoffs, and recommend a staged launch.",
      "request": {
        "privacy": "cloud_allowed"
      },
      "expected": {
        "reasoning": "high",
        "route": "cloud_eligible"
      },
      "basis": "policy"
    },
    {
      "id": "reason-02",
      "category": "reasoning",
      "prompt": "Evaluate build, buy, and partner approaches for an enterprise search product. Compare cost, speed, control, privacy, operational risk, and migration complexity; recommend a phased strategy.",
      "request": {
        "privacy": "cloud_allowed"
      },
      "expected": {
        "reasoning": "high",
        "route": "cloud_eligible"
      },
      "basis": "policy"
    },
    {
      "id": "reason-03",
      "category": "reasoning",
      "prompt": "Review this architecture across security, reliability, latency, cost, operations, scalability, migration, and failure modes. Compare multiple alternatives, synthesize the tradeoffs, recommend a phased approach, and define rollback criteria.",
      "request": {
        "privacy": "cloud_allowed"
      },
      "expected": {
        "reasoning": "extreme",
        "route": "cloud_eligible"
      },
      "basis": "policy"
    },
    {
      "id": "reason-04",
      "category": "reasoning",
      "prompt": "List pros and cons of launching in two markets.",
      "request": {
        "privacy": "cloud_allowed"
      },
      "expected": {
        "reasoning": "moderate",
        "route": "adequate"
      },
      "basis": "policy"
    },
    {
      "id": "reason-05",
      "category": "reasoning",
      "prompt": "Design a decision framework for choosing between centralized and federated ownership. Assess incentives, execution speed, accountability, failure modes, and operating cost.",
      "request": {
        "privacy": "cloud_allowed"
      },
      "expected": {
        "reasoning": "high",
        "route": "cloud_eligible"
      },
      "basis": "policy"
    },
    {
      "id": "reason-explicit-01",
      "category": "explicit_complexity",
      "prompt": "Analyze the decision.",
      "request": {
        "privacy": "cloud_allowed",
        "reasoning_complexity": "high"
      },
      "expected": {
        "reasoning": "high",
        "route": "cloud_eligible"
      },
      "basis": "hard"
    },
    {
      "id": "reason-explicit-02",
      "category": "explicit_complexity",
      "prompt": "Analyze the decision.",
      "request": {
        "privacy": "cloud_allowed",
        "reasoning_complexity": "extreme"
      },
      "expected": {
        "reasoning": "extreme",
        "route": "cloud_eligible"
      },
      "basis": "hard"
    },
    {
      "id": "code-01",
      "category": "coding",
      "prompt": "Write a Python function that returns the larger of two integers.",
      "request": {
        "required_capabilities": [
          "coding"
        ],
        "coding_complexity": "low"
      },
      "expected": {
        "coding": "low",
        "route": "adequate"
      },
      "basis": "hard"
    },
    {
      "id": "code-02",
      "category": "coding",
      "prompt": "Implement a typed Python parser for a small JSON configuration and include validation tests.",
      "request": {
        "required_capabilities": [
          "coding"
        ],
        "coding_complexity": "moderate"
      },
      "expected": {
        "coding": "moderate",
        "route": "adequate"
      },
      "basis": "hard"
    },
    {
      "id": "code-03",
      "category": "coding",
      "prompt": "Refactor a concurrent Python service with retries, idempotency, transactional state, and failure recovery; explain the architectural tradeoffs.",
      "request": {
        "privacy": "cloud_allowed",
        "required_capabilities": [
          "coding"
        ],
        "coding_complexity": "high",
        "reasoning_complexity": "high"
      },
      "expected": {
        "coding": "high",
        "reasoning": "high",
        "route": "cloud_eligible"
      },
      "basis": "hard"
    },
    {
